<clickhouse>
    <profiles>
        <default>
            <!-- Limit each query to 1 thread to avoid CPU spikes on shared host -->
            <max_threads>1</max_threads>

            <!-- Kill runaway queries after 60 seconds -->
            <max_execution_time>60</max_execution_time>

            <!-- Memory limit per single query (max ~2.5 GB) -->
            <max_memory_usage>2684354560</max_memory_usage>

            <!-- Buffer small frequent inserts to prevent part merge storms -->
            <async_insert>1</async_insert>
            <wait_for_async_insert>1</wait_for_async_insert>
            <async_insert_threads>1</async_insert_threads>
        </default>
    </profiles>
</clickhouse>
